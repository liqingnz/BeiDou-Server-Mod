# 复制成 deploy/.env 后填写真实值。deploy/.env 已被 .gitignore 排除，不会进仓库。
#   cp deploy/.env.example deploy/.env

# 镜像地址。GitHub Actions 推上去之后是 ghcr.io/<用户名>/<仓库名>:latest（全小写）。
BEIDOU_IMAGE=ghcr.io/your-github-name/beidou-server-mod:latest

# 数据库 root 密码。别用 root/123123 这类，生产换成随机串。
DB_PASSWORD=change-me

# 服务器公网 IP 或域名。
# ⚠️ 这不是“监听地址”，而是登录服发给客户端、让它去连频道服的地址。
#    填错的话玩家能登录但卡在选频道（他会去连一个连不通的地址）。
WAN_HOST=1.2.3.4

# JWT 签名密钥。生成：
#   openssl rand -hex 10
#   powershell: -join ((1..10) | ForEach { '{0:x2}' -f (Get-Random -Maximum 256) })
JWT_SECRET=change-me

# JVM 参数。实测空服堆用 442 MB，2G 机器 20 人以内 1g 够用。
# 若日志出现 OutOfMemoryError 或容器被 OOM killer 杀掉，先升到 -Xmx1280m 再看。
JAVA_OPTS=-Xms512m -Xmx1g -XX:MaxMetaspaceSize=192m
